KNOWLEDGE_PORT=18100
KNOWLEDGE_DATA_DIR=/data
KNOWLEDGE_API_KEY=
KNOWLEDGE_WORKER_INTERVAL=1
KNOWLEDGE_MAX_FILE_MB=10240

# Multi-user production resource ceilings (defaults total about 208GB/32 CPU
# across the assistant, knowledge API/worker, LightRAG and PostgreSQL).
KNOWLEDGE_API_MEMORY_LIMIT=16g
KNOWLEDGE_API_CPU_LIMIT=4.0
KNOWLEDGE_WORKER_MEMORY_LIMIT=80g
KNOWLEDGE_WORKER_CPU_LIMIT=12.0
LIGHTRAG_MEMORY_LIMIT=32g
LIGHTRAG_CPU_LIMIT=4.0
KNOWLEDGE_POSTGRES_MEMORY_LIMIT=32g
KNOWLEDGE_POSTGRES_CPU_LIMIT=4.0

# PostgreSQL 17. Leave KNOWLEDGE_DATABASE_URL unset for the local Compose default.
KNOWLEDGE_POSTGRES_DB=huizhi_knowledge
KNOWLEDGE_POSTGRES_USER=huizhi_knowledge
KNOWLEDGE_POSTGRES_PASSWORD=huizhi_knowledge
KNOWLEDGE_POSTGRES_PORT=15432
# KNOWLEDGE_DATABASE_URL=postgresql://user:password@pg17-host:5432/huizhi_knowledge

PARSER_BACKEND=auto
# MinerU is the default parser. Models are downloaded into the base image at
# build time, then loaded locally on the offline server.
KNOWLEDGE_OFFLINE=false
MINERU_MODEL_SOURCE=local
MINERU_COMMAND=mineru -p "{input}" -o "{output}" -b pipeline -m auto
# A stuck or missing local MinerU model falls back to the lightweight parser
# in auto mode instead of leaving a job in "processing" indefinitely.
MINERU_TIMEOUT_SECONDS=900

LIGHTRAG_URL=
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix

# ============================================================
# Model Provider Configuration
# ============================================================
# Chat/LLM provider (OpenAI-compatible endpoint; keep the /v1 suffix)
CHAT_BASE_URL=http://chat-server-ip:port/v1
CHAT_API_KEY=replace-with-chat-key

# Embedding provider can be a different server from the chat provider.
EMBEDDING_BASE_URL=http://embedding-server-ip:port/v1
EMBEDDING_API_KEY=replace-with-embedding-key

# Backward-compatible defaults used by older integrations. Keep them equal to
# the chat provider when those integrations are still enabled.
PROVIDER_BASE_URL=http://chat-server-ip:port/v1
PROVIDER_API_KEY=replace-with-chat-key

# Model configuration - specify model names explicitly
# Knowledge service will call the provider to generate answers and embeddings
CHAT_MODEL=gemma-4-26B-A4B-it-MLX-4bit
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-8bit
RERANKER_MODEL=Qwen3-Reranker-0.6B-4bit
RERANKER_ENABLED=true
