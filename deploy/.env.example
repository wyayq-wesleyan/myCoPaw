# 主应用（汇智小助手）环境变量模板 —— 与 deploy/docker-compose.code-mount.arm64.yml 同版本。
#
# 用法：复制为 deploy/.env 后按正式机器修改。该文件由当前版本的 Compose 默认值推导，
# 用于与线上 .env 逐项核对。带“默认”的值即使不写也与这里一致。
#
# 注意：.env 不进入代码包，也不进 Git（.gitignore 忽略 .env 与 .env.*，但放行 .env.example）。

# ---------------------------------------------------------------- 基础
# Compose 用它同时决定 QWENPAW_PORT 与 supervisord 的 --port 替换值。
COPAW_PORT=8088
TZ=Asia/Shanghai

# 镜像名。代码挂载部署下改代码不需要换镜像，只有在重建底座时才需要改这里。
MYCOPAW_IMAGE=huizhi-runtime:2.2.1-arm64

# ---------------------------------------------------------------- 资源上限（上限而非常驻占用）
# 必须按下述口径留出余量，不要把宿主机内存全部分给容器。
QWENPAW_MEMORY_LIMIT=48g
QWENPAW_CPU_LIMIT=8.0
QWENPAW_PIDS_LIMIT=512

# 应用日志落盘的宿主机目录（容器内固定为 /app/working/logs）。
QWENPAW_HOST_LOG_DIR=./data/logs
QWENPAW_LOG_LEVEL=info

# ---------------------------------------------------------------- 认证（生产必须为 true）
QWENPAW_AUTH_ENABLED=true
QWENPAW_AUTH_USERNAME=admin
# 正式环境务必替换为强密码。
QWENPAW_AUTH_PASSWORD=请替换为强密码
# 为 true 时 127.0.0.1 不再免除认证，且入场脚本会把 allow_no_auth_hosts 清空。
QWENPAW_FORCE_AUTH_ON_LOCALHOST=true

# 只使用内建的 console 频道，禁用全部外部渠道。
QWENPAW_ENABLED_CHANNELS=console

# ---------------------------------------------------------------- 模型并发与流式看门狗
QWENPAW_LLM_MAX_CONCURRENT=6
# 自建模型慢，首内容要等很久（长上下文尤其明显），故放宽到 5 分钟。
QWENPAW_LLM_STREAM_FIRST_CONTENT_TIMEOUT=300
QWENPAW_LLM_STREAM_IDLE_TIMEOUT=300

# ---------------------------------------------------------------- 账号数据库（本地 PG17 容器）
# 默认指向 knowledge-service/docker-compose.postgres.yml 暴露的 15432 端口，标准离线部署无需修改。
QWENPAW_DATA_TABLES_DB_HOST=127.0.0.1
QWENPAW_DATA_TABLES_DB_PORT=15432
QWENPAW_DATA_TABLES_DB_NAME=huizhi_knowledge
QWENPAW_DATA_TABLES_DB_USER=huizhi_knowledge
QWENPAW_DATA_TABLES_DB_PASSWORD=huizhi_knowledge

# ---------------------------------------------------------------- 平台数据库
# 平台自身数据（会话历史、治理审计等）使用 PostgreSQL，不再使用 SQLite。
# 默认复用上面 QWENPAW_DATA_TABLES_DB_* 指向的同一实例；仅当要把平台库放到
# 独立服务器时才需要放开下面几项。
# QWENPAW_PLATFORM_DB_HOST=127.0.0.1
# QWENPAW_PLATFORM_DB_PORT=15432
# QWENPAW_PLATFORM_DB_NAME=huizhi_knowledge
# QWENPAW_PLATFORM_DB_USER=huizhi_knowledge
# QWENPAW_PLATFORM_DB_PASSWORD=huizhi_knowledge

# ---------------------------------------------------------------- 知识服务（不在 Compose 里，只能写这里）
# 未配置则聊天中完全没有知识检索能力，且不报错。两侧 Key 必须一致，或都留空。
# QWENPAW_KNOWLEDGE_URL=http://127.0.0.1:18100
# QWENPAW_KNOWLEDGE_API_KEY=replace-with-a-long-random-key

# ---------------------------------------------------------------- 大数据/Oracle 客户端（按需覆盖）
# 默认值已与镜像内路径一致，只有装在别处才需要放开。
# HADOOP_HOME=/opt/hadoop
# HIVE_HOME=/opt/hive3
# HIVE2_HOME=/opt/hive2
# HIVE3_HOME=/opt/hive3
# ORACLE_HOME=/opt/oracle/instantclient
# LD_LIBRARY_PATH=/opt/oracle/instantclient:/usr/local/lib
