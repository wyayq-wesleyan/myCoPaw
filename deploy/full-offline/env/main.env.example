# ============================================================================
# 汇智小助手 —— 主应用环境变量
# 与同目录 docker-compose.yml 配套。改完需要重启：docker compose up -d --force-recreate
#
# 标记「★ 必须修改」的项在正式环境一定要改；其余保持默认即可。
# ============================================================================

# ---------------------------------------------------------------- 基础
# 应用监听端口（宿主机，通过 network_mode: host 直接占用）。
COPAW_PORT=8088
TZ=Asia/Shanghai

# 底座镜像名 —— 与 images/ 里加载进来的镜像保持一致，不要改。
MYCOPAW_IMAGE=huizhi-runtime:2.2.1-amd64

# ---------------------------------------------------------------- 认证（★ 必须修改密码）
QWENPAW_AUTH_ENABLED=true
QWENPAW_AUTH_USERNAME=admin
# ★ 上线前务必替换为强密码。
QWENPAW_AUTH_PASSWORD=请替换为强密码
# true = 即使从 127.0.0.1 访问也要求认证（生产建议保持 true）。
QWENPAW_FORCE_AUTH_ON_LOCALHOST=true

# 只用内建的 console（网页）频道，禁用全部外部渠道。
QWENPAW_ENABLED_CHANNELS=console

# ---------------------------------------------------------------- 知识服务对接（★ 需要确认）
# 知识服务起来之后才有检索能力；不配这两项时网页不报错，但知识检索恒为空。
# KEY 必须与 knowledge-service/.env 里的 KNOWLEDGE_API_KEY 一致（或都留空）。
QWENPAW_KNOWLEDGE_URL=http://127.0.0.1:18100
QWENPAW_KNOWLEDGE_API_KEY=请替换为随机长字符串

# ---------------------------------------------------------------- 账号数据库 / 平台数据库
# 都指向 knowledge-service 起的本地 PG17 容器（宿主机 15432 端口）。
# 会话历史、治理审计、词元统计、数据表都已统一到 PostgreSQL，不再使用 SQLite。
QWENPAW_DATA_TABLES_DB_HOST=127.0.0.1
QWENPAW_DATA_TABLES_DB_PORT=15432
QWENPAW_DATA_TABLES_DB_NAME=huizhi_knowledge
QWENPAW_DATA_TABLES_DB_USER=huizhi_knowledge
QWENPAW_DATA_TABLES_DB_PASSWORD=huizhi_knowledge

# ---------------------------------------------------------------- 资源上限（上限，不是常驻占用）
# 按机器实际内存设置，务必给宿主机和其他服务留余量，不要把内存全分给容器。
QWENPAW_MEMORY_LIMIT=48g
QWENPAW_CPU_LIMIT=8.0
QWENPAW_PIDS_LIMIT=512

# 日志落盘的宿主机目录（相对本目录）。容器内固定为 /app/working/logs。
QWENPAW_HOST_LOG_DIR=./data/logs
QWENPAW_LOG_LEVEL=info

# ---------------------------------------------------------------- 模型并发与流式看门狗
# 超过并发数的请求排队，避免上游超时；按模型服务能力调整。
QWENPAW_LLM_MAX_CONCURRENT=6
QWENPAW_LLM_STREAM_FIRST_CONTENT_TIMEOUT=300
QWENPAW_LLM_STREAM_IDLE_TIMEOUT=300

# ---------------------------------------------------------------- 大数据 / Oracle 客户端（按需）
# 默认值已与镜像内路径一致，只有客户端装在别处才需要放开。
# HADOOP_HOME=/opt/hadoop
# HIVE_HOME=/opt/hive3
# HIVE2_HOME=/opt/hive2
# HIVE3_HOME=/opt/hive3
# ORACLE_HOME=/opt/oracle/instantclient
# LD_LIBRARY_PATH=/opt/oracle/instantclient:/usr/local/lib
