# ============================================================================
# 汇智小助手 —— 知识服务环境变量
# 与同目录 docker-compose.yml（api/worker）和 docker-compose.postgres.yml（PG17）配套。
#
# 三处需要按现场填写：模型地址（★1）、知识服务 Key（★2）、图谱库开关（★3）。
# ============================================================================

KNOWLEDGE_PORT=18100
KNOWLEDGE_DATA_DIR=/data
# ★2 知识服务调用密钥。必须与主应用 .env 的 QWENPAW_KNOWLEDGE_API_KEY 一致
#    （或两边都留空）。留空 = 不校验，仅适合完全隔离的内网。
KNOWLEDGE_API_KEY=请替换为随机长字符串
KNOWLEDGE_WORKER_INTERVAL=1
KNOWLEDGE_MAX_FILE_MB=10240

# ---------------------------------------------------------------- 日志
# api / worker / lightrag 三个容器都写到容器内 /var/log/knowledge，并挂到宿主机。
KNOWLEDGE_HOST_LOG_DIR=./data/logs
KNOWLEDGE_LOG_LEVEL=INFO
# 是否把实际执行的 SQL 打进日志（排障时最有用）。设为 false 可关闭。
KNOWLEDGE_SQL_LOG=true

# ---------------------------------------------------------------- 资源上限
# 下面几项与主应用 .env 的 QWENPAW_MEMORY_LIMIT 一起构成全部容器的内存上限，
# 总和必须小于宿主机内存，务必按机器实际调整。
KNOWLEDGE_API_MEMORY_LIMIT=16g
KNOWLEDGE_API_CPU_LIMIT=4.0
KNOWLEDGE_WORKER_MEMORY_LIMIT=80g
KNOWLEDGE_WORKER_CPU_LIMIT=12.0
LIGHTRAG_MEMORY_LIMIT=32g
LIGHTRAG_CPU_LIMIT=4.0
KNOWLEDGE_POSTGRES_MEMORY_LIMIT=32g
KNOWLEDGE_POSTGRES_CPU_LIMIT=4.0

# ---------------------------------------------------------------- PostgreSQL 17
KNOWLEDGE_POSTGRES_DB=huizhi_knowledge
KNOWLEDGE_POSTGRES_USER=huizhi_knowledge
KNOWLEDGE_POSTGRES_PASSWORD=huizhi_knowledge
KNOWLEDGE_POSTGRES_PORT=15432
# 平台自身的会话历史/审计 + 各账号分析库共用该实例，连接上限要高于镜像默认的 100。
KNOWLEDGE_POSTGRES_MAX_CONNECTIONS=200

# ---------------------------------------------------------------- 解析器
PARSER_BACKEND=auto
# MinerU 模型已打进镜像，离线环境用 local 直接加载。
KNOWLEDGE_OFFLINE=false
MINERU_MODEL_SOURCE=local
MINERU_COMMAND=mineru -p "{input}" -o "{output}" -b pipeline -m auto
# 本地 MinerU 卡住或模型缺失时，auto 模式会退回轻量解析器，不会把任务永久挂在 processing。
MINERU_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------- 模型服务（★1 必须修改）
# 聊天与嵌入可以是两台不同服务器，都要求 OpenAI 兼容、带 /v1 后缀。
CHAT_BASE_URL=http://模型服务器IP:端口/v1
CHAT_API_KEY=请替换为聊天服务密钥

EMBEDDING_BASE_URL=http://嵌入模型服务器IP:端口/v1
EMBEDDING_API_KEY=请替换为嵌入服务密钥

# 兼容旧集成的别名，保持与聊天服务一致即可。
PROVIDER_BASE_URL=http://模型服务器IP:端口/v1
PROVIDER_API_KEY=请替换为聊天服务密钥

# 模型名必须与模型服务上真实的名称一致，否则解析/检索全部失败。
CHAT_MODEL=请填写聊天模型名
EMBEDDING_MODEL=请填写嵌入模型名
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=
RERANKER_ENABLED=false

# ---------------------------------------------------------------- 知识图谱（★3）
# 图谱是检索的「增强项」：不启用只是少了图谱证据，本地全文/向量检索照常工作。
#
# 留空(推荐，多租户隔离) → 知识服务进程内直连 PostgreSQL，每个路径一个 workspace，
#                          隔离由数据库主键保证，跨案件读不到彼此；
# 填 http://lightrag:9621    → 旧的共享图谱 + 应用层过滤（仅在排查老问题时使用）。
LIGHTRAG_URL=
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix

# 多租户图谱库（留空 LIGHTRAG_URL 时生效）。首次初始化由 initdb/ 脚本自动创建；
# 若数据库已存在（数据目录非空），需要手工执行 README 里那条 CREATE DATABASE。
KNOWLEDGE_GRAPH_DATABASE_URL=postgresql://huizhi_knowledge:huizhi_knowledge@host.docker.internal:15432/huizhi_knowledge_graph
# 同时驻留的 workspace 上限（LRU 淘汰）与每个 workspace 的连接池上限。
# 连接总量 ≈ 上限 × 池上限，必须小于 KNOWLEDGE_POSTGRES_MAX_CONNECTIONS。
KNOWLEDGE_GRAPH_MAX_WORKSPACES=32
KNOWLEDGE_GRAPH_POOL_MAX_CONNECTIONS=8
