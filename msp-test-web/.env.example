# 复制为 .env 后按现场修改：cp .env.example .env
BASE_IMAGE=huizhi-runtime:2.2.1-amd64

# middleware 地址：
# - host 网络下可以用 127.0.0.1
# - 非 host 网络请改成 middleware 的宿主机 IP 或服务名
MIDDLEWARE_BASE_URL=http://127.0.0.1:9089

# MSP 菜单/权限编码
MSP_TEST_SYSTEM_CODE=middleware
# TCMS 编码；留空跟随 MSP
MSP_TEST_TCMS_SYSTEM_CODE=
# ELC 编码；留空跟随 MSP
MSP_TEST_ELC_SYSTEM_CODE=

MSP_TEST_PORT=18080

# 可选：SSO 登出地址；配置后首页出现“SSO 登出”
MSP_TEST_SSO_LOGOUT_URL=

# HTTPS 自签证书时设 false
MSP_TEST_VERIFY_TLS=false

# 多人共用时建议改掉
MSP_TEST_SECRET_KEY=integration-console-internal-only

TZ=Asia/Shanghai
